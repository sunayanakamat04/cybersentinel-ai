# CyberSentinel AI Environment Configuration

# Server Settings
APP_NAME="CyberSentinel AI"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (PostgreSQL / SQLite for local development)
# For local SQLite dev without running postgres:
DATABASE_URL=sqlite+aiosqlite:///./cybersentinel.db
DATABASE_SYNC_URL=sqlite:///./cybersentinel.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybersentinel_db
# DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/cybersentinel_db

# Model Paths
SUPERVISED_MODEL_PATH=models/xgboost_classifier_v1.joblib
ANOMALY_MODEL_PATH=models/isolation_forest_v1.joblib
PREPROCESSOR_PATH=models/feature_preprocessor_v1.joblib
EXPLAINER_PATH=models/shap_explainer_v1.joblib

# Thresholds & Detection Policy
ANOMALY_THRESHOLD=0.65
ALERT_PROBABILITY_THRESHOLD=0.50
DRIFT_P_VALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.20

# Feature Settings
TOP_K_SHAP_FEATURES=5
BATCH_INFERENCE_MAX_SIZE=5000
